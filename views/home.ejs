<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
    <title>Home · ByteBlog</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='16' fill='%232F6BFF'/><text x='50%' y='54%' text-anchor='middle' dominant-baseline='middle' font-size='38' fill='white'>B</text></svg>">
    
    
</head>

<body class="page-home">

    <%- include('./partials/nav') %>

    <div class="bb-container animate-fade-in">

        <!-- HERO -->
        <section class="hero-section">
            <h1>
                <% if (locals.user) { %>
                    Welcome back, <%= locals.user.name ? locals.user.name.split(' ')[0] : '' %>
                <% } else { %>
                    Welcome to ByteBlog
                <% } %>
            </h1>
            <p>Discover ideas, stories, and developer thoughts crafted by the community.</p>
        </section>

        <!-- POSTS LOGIC -->
        <section>
            <% if (!locals.user) { %>
                <!-- NOT LOGGED IN -->
                <div class="empty-state">
                    <h2>Join the Conversation</h2>
                    <p>You need an account to view and interact with blog posts. It only takes a minute.</p>
                    <a href="/user/signin" class="btn btn-primary">Sign in to Read</a>
                </div>

            <% } else if (!locals.blog || locals.blog.length === 0) { %>
                <!-- LOGGED IN BUT NO POSTS -->
                <div class="empty-state">
                    <h2>No posts available yet</h2>
                    <p>Be the first one to create a post and share your thoughts with the community.</p>
                    <a href="/blog/addBlog" class="btn btn-primary">Create the first post</a>
                </div>

            <% } else { %>
                <!-- POSTS GRID -->
                <div class="grid-cards">
                    <% locals.blog.forEach((blog) => { %>
                        <a class="card blog-card" href="/blog/showBlog/<%= blog._id %>">
                            <div class="blog-card-img-wrapper">
                                <% if (blog.coverImageUrl) { %>
                                    <img src="<%= blog.coverImageUrl %>" loading="lazy" alt="Blog cover">
                                <% } else { %>
                                    <div class="blog-card-placeholder">No Image Available</div>
                                <% } %>
                            </div>
                            
                            <div class="blog-card-body">
                                <div class="blog-card-meta">
                                    <span>
                                        <%= new Date(blog.createdAt).toLocaleDateString('en-US', {
                                            month: 'short',
                                            day: 'numeric',
                                            year: 'numeric'
                                        }) %>
                                    </span>
                                    <span class="dot"></span>
                                    <span>👁 <%= blog.views || 0 %> views</span>
                                </div>
                                
                                <div class="blog-card-title">
                                    <%= blog.title %>
                                </div>
                                
                                <div class="blog-card-footer d-flex justify-content-between align-items-center">
                                    <span class="btn btn-ghost" style="padding: 6px 12px; margin-left: -12px;">Read Article →</span>
                                </div>
                            </div>
                        </a>
                    <% }) %>
                </div>
            <% } %>
        </section>

    </div>

</body>
</html>