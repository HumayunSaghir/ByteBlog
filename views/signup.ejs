<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Sign up · ByteBlog</title>

    <!-- Favicon (inline SVG — matches the ByteBlog logo mark) -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='16' fill='%232F6BFF'/><text x='50%25' y='54%25' text-anchor='middle' dominant-baseline='middle' font-family='-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial,sans-serif' font-weight='800' font-size='38' fill='white'>B</text></svg>">
    <link rel="apple-touch-icon" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='16' fill='%232F6BFF'/><text x='50%25' y='54%25' text-anchor='middle' dominant-baseline='middle' font-family='-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial,sans-serif' font-weight='800' font-size='38' fill='white'>B</text></svg>">

    
</head>
<body class="page-signup">

    <div class="bb-shell">

        <!-- LEFT BRAND PANEL -->
        <aside class="bb-brand">
            <div class="bb-logo">
                <span class="bb-logo-mark">B</span>
                <span>ByteBlog</span>
            </div>

            <div class="bb-hero">
                <h2>Join a community of curious readers and writers.</h2>
                <p>Create your free ByteBlog account in seconds. Discover thoughtful writing, follow voices you love, and start publishing stories of your own.</p>

                <ul class="bb-feature-list">
                    <li>
                        <span class="bb-check">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                        Free forever — no credit card required
                    </li>
                    <li>
                        <span class="bb-check">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                        Publish your first post in under a minute
                    </li>
                    <li>
                        <span class="bb-check">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                        Connect with thousands of writers worldwide
                    </li>
                </ul>
            </div>

            <div class="bb-foot">© <%= new Date().getFullYear() %> ByteBlog · Crafted for curious minds</div>
        </aside>

        <!-- RIGHT FORM PANEL -->
        <main class="bb-form-wrap">
            <div class="bb-card">

                <div class="bb-card-head">
                    <h1>Create your account</h1>
                    <p>Start your ByteBlog journey — it only takes a moment.</p>
                </div>

                <% if (locals.message) { %>
                    <div class="bb-alert" role="alert">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <p><%= locals.message %></p>
                    </div>
                <% } %>

                <form method="post" action="/user/signup" novalidate>

                    <div class="bb-field">
                        <label for="fullname" class="form-label">Full name</label>
                        <input type="text" class="form-control" id="fullname" name="fullname" placeholder="Jane Doe" autocomplete="name" required>
                    </div>

                    <div class="bb-field">
                        <label for="exampleInputEmail1" class="form-label">Email address</label>
                        <input type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" name="email" placeholder="you@example.com" autocomplete="email" required>
                        <div id="emailHelp" class="form-text">We'll never share your email with anyone else.</div>
                    </div>

                    <div class="bb-field">
                        <label for="exampleInputPassword1" class="form-label">Password</label>
                        <input type="password" class="form-control" id="exampleInputPassword1" name="password" placeholder="At least 8 characters" autocomplete="new-password" required>
                        <div class="bb-strength" aria-hidden="true">
                            <span class="bb-strength-bar" id="bar1"></span>
                            <span class="bb-strength-bar" id="bar2"></span>
                            <span class="bb-strength-bar" id="bar3"></span>
                            <span class="bb-strength-bar" id="bar4"></span>
                        </div>
                        <div class="bb-strength-text" id="strengthText"></div>
                    </div>

                    <label class="bb-terms">
                        <input type="checkbox" name="terms" required>
                        <span>I agree to ByteBlog's <a href="/terms" class="bb-link">Terms of Service</a> and <a href="/privacy" class="bb-link">Privacy Policy</a>.</span>
                    </label>

                    <button type="submit" class="btn btn-primary">Create account</button>

                </form>

                <p class="bb-signin">
                    Already have an account? <a href="/user/signin" class="bb-link">Sign in</a>
                </p>

            </div>
        </main>

    </div>

    <script>
        // Password strength meter — purely visual feedback
        (function () {
            const pwd = document.getElementById('exampleInputPassword1');
            const bars = [1,2,3,4].map(n => document.getElementById('bar' + n));
            const txt  = document.getElementById('strengthText');
            const labels = ['', 'Weak', 'Fair', 'Good', 'Strong'];
            const colors = ['#94A3B8', '#EF4444', '#F59E0B', '#10B981', '#059669'];

            function score(v) {
                let s = 0;
                if (v.length >= 8) s++;
                if (/[A-Z]/.test(v) && /[a-z]/.test(v)) s++;
                if (/\d/.test(v)) s++;
                if (/[^A-Za-z0-9]/.test(v)) s++;
                if (v.length === 0) s = 0;
                return s;
            }

            pwd.addEventListener('input', function () {
                const s = score(pwd.value);
                bars.forEach((b, i) => {
                    b.className = 'bb-strength-bar' + (i < s ? ' active-' + s : '');
                });
                txt.textContent = pwd.value ? labels[s] + ' password' : '';
                txt.style.color = pwd.value ? colors[s] : 'var(--bb-muted)';
            });
        })();
    </script>

    <%- include('./partials/script') %>
</body>
</html>