<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Sign in · ByteBlog</title>

    <!-- Favicon (inline SVG — matches the ByteBlog logo mark) -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='16' fill='%232F6BFF'/><text x='50%25' y='54%25' text-anchor='middle' dominant-baseline='middle' font-family='-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial,sans-serif' font-weight='800' font-size='38' fill='white'>B</text></svg>">
    <link rel="apple-touch-icon" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='16' fill='%232F6BFF'/><text x='50%25' y='54%25' text-anchor='middle' dominant-baseline='middle' font-family='-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial,sans-serif' font-weight='800' font-size='38' fill='white'>B</text></svg>">

    
</head>
<body class="page-signin">

    <div class="bb-shell">

        <!-- LEFT BRAND PANEL -->
        <aside class="bb-brand">
            <div class="bb-logo">
                <span class="bb-logo-mark">B</span>
                <span>ByteBlog</span>
            </div>

            <div class="bb-hero">
                <h2>Stories, ideas and bytes — all in one place.</h2>
                <p>Sign in to continue reading the writers you follow, pick up where you left off, and share what's on your mind with the ByteBlog community.</p>

                <ul class="bb-feature-list">
                    <li>
                        <span class="bb-check">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                        A personalised feed tuned to what you read
                    </li>
                    <li>
                        <span class="bb-check">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                        Bookmark articles and read them offline
                    </li>
                    <li>
                        <span class="bb-check">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                        Publish your own posts in minutes
                    </li>
                </ul>
            </div>

            <div class="bb-foot">© <%= new Date().getFullYear() %> ByteBlog · Crafted for curious minds</div>
        </aside>

        <!-- RIGHT FORM PANEL -->
        <main class="bb-form-wrap">
            <div class="bb-card">

                <div class="bb-card-head">
                    <h1>Sign in</h1>
                    <p>Enter your details below to access your ByteBlog account.</p>
                </div>

                <% if (locals.message) { %>
                    <div class="bb-alert" role="alert">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <p><%= locals.message %></p>
                    </div>
                <% } %>

                <form method="post" action="/user/signin" novalidate>

                    <div class="bb-field">
                        <label for="exampleInputEmail1" class="form-label">Email address</label>
                        <input type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" name="email" placeholder="you@example.com" autocomplete="email" required>
                        <div id="emailHelp" class="form-text">We'll never share your email with anyone else.</div>
                    </div>

                    <div class="bb-field">
                        <label for="exampleInputPassword1" class="form-label">Password</label>
                        <input type="password" class="form-control" id="exampleInputPassword1" name="password" placeholder="Enter your password" autocomplete="current-password" required>
                    </div>

                    <div class="bb-row">
                        <a href="/user/forgot-password" class="bb-link">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn btn-primary">Sign in to ByteBlog</button>

                </form>

                <p class="bb-signup">
                    New to ByteBlog? <a href="/user/signup" class="bb-link">Create an account</a>
                </p>

            </div>
        </main>

    </div>

    <%- include('./partials/script') %>
</body>
</html>